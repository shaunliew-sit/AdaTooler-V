#!/bin/bash
#PBS -q ai
#PBS -N grpo-sft-alpha0
#PBS -l select=1:ngpus=8:ncpus=64:mem=480gb
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -P 11104496

# ── Enter working directory ──
cd ${PBS_O_WORKDIR:-/home/users/sit/a104059/scratch/11104496/AdaTooler-V/verltool}

# ── Load environment ──
module load miniforge3
module load cuda/12.2.2
module load gcc/11.2.0-nscc
conda activate verl-tool-env


# ── Print diagnostics ──
echo "=== Job Info ==="
echo "Job ID: $PBS_JOBID"
echo "Node:   $(hostname)"
echo "Date:   $(date)"
echo "PWD:    $(pwd)"
echo ""
nvidia-smi
echo ""
python -c "import torch; print(f'PyTorch {torch.__version__}, CUDA: {torch.cuda.is_available()}, GPUs: {torch.cuda.device_count()}')"
echo "CUDA_VISIBLE_DEVICES=$CUDA_VISIBLE_DEVICES"
echo ""

# ── Count GPUs (assigned by PBS) ──
NUM_GPUS=$(echo $CUDA_VISIBLE_DEVICES | tr ',' '\n' | wc -l)
echo "Using $NUM_GPUS GPUs"

# ── Set environment variables ──
export LD_LIBRARY_PATH=/home/users/sit/a104059/.conda/envs/verl-tool-env/lib:$LD_LIBRARY_PATH
export NCCL_DEBUG=INFO
export WANDB_PROJECT=SAHA-CF
# Compute nodes have no network: log offline, sync later from the login node
export WANDB_MODE=offline
# Prevent huggingface_hub from validating local model paths as HF repo IDs
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
# flash_attn lives outside the conda env (built by build_flash_attn.pbs)
export PYTHONPATH=$(pwd):$(pwd)/verl:/home/users/sit/a104059/scratch/11104496/pylibs:$PYTHONPATH

# ── Training knobs (read by train_qwen3vl_v2.sh) ──
# ALPHA=0 -> R_total = R_format*R_outcome: the PTG tool term is off, i.e. vanilla
# GRPO reward on the SAHA SFT model. ALPHA is part of run_name, so this cannot
# collide with the a0.6 run and DATA_TAG stays the same for comparability.
export NGPUS=$NUM_GPUS
export TP=1
export BATCH_SIZE=16
export PPO_MINI=16
export MAX_CONCURRENT=96
export TOOL_WORKERS=8
export DO_OFFLOAD=True
export GPU_MEM=0.30
export ALPHA=0
export N=6
export TOTAL_STEPS=1000
export SAHA_CF_GROUNDING_METRIC=minAR10
export DATA_TAG=newsft-resampled-8b
export RESUME_MODE=auto
export TRAIN_PARQUET=$(pwd)/data/train_resampled_moderate.parquet
export VAL_PARQUET=$(pwd)/data/val.parquet

# ── Model path ──
MODEL_PATH=/home/users/sit/a104059/scratch/11104496/models/merged/qwen3vl-8b-saha-sft-merged

echo "=== Starting GRPO Training ==="
echo "Model: $MODEL_PATH"
echo "Data:  $TRAIN_PARQUET"
echo ""

# ── Run training ──
bash examples/train/hoi/train_qwen3vl_v2.sh $MODEL_PATH

echo "=== Training Complete ==="
echo "End: $(date)"
