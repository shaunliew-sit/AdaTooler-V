#!/bin/bash
#PBS -q normal
#PBS -N build-flash-attn
#PBS -l select=1:ncpus=16:mem=64gb
#PBS -l walltime=04:00:00
#PBS -j oe
#PBS -P 11104496

# Build flash-attn 2.8.3 FROM SOURCE against the local glibc.
#
# Why: the prebuilt wheel (flash_attn-2.8.3+cu12torch2.8cxx11abiTRUE-cp310...) is
# built on glibc >= 2.32; ASPIRE 2A is glibc 2.28, so it fails at import with
#   ImportError: /lib64/libc.so.6: version `GLIBC_2.32' not found
# No wheel fixes this -- it has to be compiled here.
#
# verl needs flash_attn unconditionally on CUDA: verl/utils/attention_utils.py
# imports flash_attn.bert_padding with no fallback, and fsdp_workers defaults
# attn_implementation=flash_attention_2.
#
# Runs on a CPU node: nvcc compiles CUDA kernels without a GPU present, and the
# CPU queue schedules far faster than `ai`. ~30-60 min.
#
# Submit:
#   qsub examples/train/hoi/build_flash_attn.pbs

# ── Load environment ──
module load miniforge3
module load cuda/12.2.2
module load gcc/11.2.0-nscc
conda activate verl-tool-env

# ── Paths ──
# Install target: scratch, because the /data project fileset is full and the home
# fileset is at quota. train_hoi_grpo_v2.pbs already looks here.
PYLIBS=${PYLIBS:-/home/users/sit/a104059/scratch/11104496/pylibs}
# pip's build dir AND cache must be on one filesystem, or setup.py's os.rename
# fails with "Invalid cross-device link" (pypa/pip#103).
export TMPDIR=${TMPDIR:-/home/users/sit/a104059/scratch/tmp}
PIPCACHE=${PIPCACHE:-/home/users/sit/a104059/scratch/.pipcache}
mkdir -p "$PYLIBS" "$TMPDIR" "$PIPCACHE"

export LD_LIBRARY_PATH=/home/users/sit/a104059/.conda/envs/verl-tool-env/lib:$LD_LIBRARY_PATH

# ── Build knobs ──
# MAX_JOBS caps ninja parallelism. The default (-j 9) runs 9 `cicc` processes at
# ~3 GB each and gets OOM-killed; 4 fits inside 64 GB.
export MAX_JOBS=${MAX_JOBS:-4}
export NVCC_THREADS=${NVCC_THREADS:-2}
# sm_80 = A100, the only GPU in the `ai` queue. Single arch ~4x faster to build.
export FLASH_ATTN_CUDA_ARCHS=${FLASH_ATTN_CUDA_ARCHS:-80}
export FLASH_ATTENTION_FORCE_BUILD=TRUE   # skip the incompatible prebuilt wheel

# ── Print diagnostics ──
echo "=== Job Info ==="
echo "Job ID: $PBS_JOBID"
echo "Node:   $(hostname)"
echo "Date:   $(date)"
echo "glibc:  $(ldd --version | head -1)"
echo "gcc:    $(gcc --version | head -1)"
echo "nvcc:   $(nvcc --version | tail -2 | head -1)"
echo "target: $PYLIBS"
echo "MAX_JOBS=$MAX_JOBS NVCC_THREADS=$NVCC_THREADS ARCHS=$FLASH_ATTN_CUDA_ARCHS"
python -c "import torch; print('torch', torch.__version__)"
echo ""

# ── Remove any previous (incompatible) install ──
rm -rf "$PYLIBS"/flash_attn "$PYLIBS"/flash_attn-*.dist-info "$PYLIBS"/flash_attn_2_cuda*.so

# ── Build ──
echo "=== Building flash-attn 2.8.3 from source ==="
pip install --no-deps --no-build-isolation \
    --target "$PYLIBS" \
    --cache-dir "$PIPCACHE" \
    flash-attn==2.8.3
rc=$?
echo "=== pip exited rc=$rc at $(date) ==="

# ── Verify ──
# Import will still warn about no CUDA runtime on a CPU node; what matters is
# that it is not ImportError/GLIBC.
PYTHONPATH="$PYLIBS" python -c "import flash_attn; print('OK flash_attn', flash_attn.__version__)"

echo "=== Done: $(date) ==="
exit $rc
