#!/bin/bash
#PBS -q ai
#PBS -N saha-cf-grpo-v2
#PBS -l select=1:ngpus=8:ncpus=64:mem=480gb
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -P 11104496

# ─────────────────────────────────────────────────────────────────────────────
# SAHA-CF (v3 PTG reward) GRPO on the HPC — PBS wrapper for
# examples/train/hoi/train_qwen3vl_v2.sh
#
# SUBMIT:
#   cd $SCRATCH/AdaTooler-V/verltool
#   qsub examples/train/hoi/train_hoi_grpo_v2.pbs
#
#   # override any knob without editing the file:
#   qsub -v ALPHA=0.3,MODEL_SIZE=8b,TOTAL_STEPS=500 examples/train/hoi/train_hoi_grpo_v2.pbs
#
# 8 GPUs, ONE node. train_qwen3vl_v2.sh defaults to a single GPU (the dev box);
# NGPUS=8 below scales it: FSDP (fsdp_size=-1) shards the actor across all 8 and
# TP=1 gives each GPU its own vLLM replica, so the rollout — the slow part, since
# every trajectory does up to 5 tool turns — runs 8-way data-parallel.
#
# BATCH SIZE IS CONSTRAINED: verl asserts train_batch_size * n % n_gpus == 0
# (verl/utils/config.py:109). With n=6 on 8 GPUs, BATCH_SIZE must be a multiple
# of 4. The training script now checks this up front and exits with the rule.
#
# WALLTIME: 1000 steps will not finish in 24h even on 8 GPUs. The run checkpoints
# every 5 steps and train_qwen3vl_v2.sh defaults to resume_mode=auto, so simply
# re-qsub the same job and it picks up from the last global_step_*. Set
# AUTO_RESUBMIT=1 to chain automatically.
# ─────────────────────────────────────────────────────────────────────────────

set -o pipefail

# ── Enter working directory ──
cd ${PBS_O_WORKDIR:-/home/users/sit/a104059/scratch/AdaTooler-V/verltool} || exit 1
REPO_ROOT=$(pwd)

# ── Load environment ──
module load miniforge3
module load cuda/12.2.2
module load gcc/11.2.0-nscc
source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate verl-tool-env || { echo "FATAL: conda env verl-tool-env not found" >&2; exit 1; }

# ─────────────────────────────────────────────────────────────────────────────
# Paths — EDIT THESE for the HPC filesystem layout.
# On the dev box these lived under /workspace/data; on NSCC they belong in
# scratch. Everything below is overridable with `qsub -v NAME=value`.
# ─────────────────────────────────────────────────────────────────────────────
# NSCC layout (2026-08-29): images + parquets under .../11104496/data,
# models under .../11104496/models{,/merged}.
DATA_ROOT=${DATA_ROOT:-/home/users/sit/a104059/scratch/11104496/data}
MODEL_ROOT=${MODEL_ROOT:-/home/users/sit/a104059/scratch/11104496/models}
MODEL_SIZE=${MODEL_SIZE:-8b}                       # 4b | 8b -- 8B is the paper's main model
# Default = the LoRA-merged re-SFT (collapse fix). For the "direct GRPO" ablation
# (GRPO straight from base, no SAHA SFT) pass the base explicitly, e.g.
#   qsub -v MODEL_PATH=$MODEL_ROOT/Qwen3-VL-8B-Instruct,DATA_TAG=base8b-nosft ...
MODEL_PATH=${MODEL_PATH:-$MODEL_ROOT/merged/qwen3vl-${MODEL_SIZE}-saha-sft-merged}
export TRAIN_PARQUET=${TRAIN_PARQUET:-$REPO_ROOT/data/train_resampled_moderate.parquet}
export VAL_PARQUET=${VAL_PARQUET:-$REPO_ROOT/data/val.parquet}

# ── Scale-out knobs (8 GPUs, one node) ──
export NGPUS=${NGPUS:-8}
export TP=${TP:-1}                                 # 1 vLLM replica per GPU; raise only if a
                                                   # single GPU cannot hold the model
# batch_size*n must be divisible by NGPUS -> with n=6 on 8 GPUs, multiples of 4.
export BATCH_SIZE=${BATCH_SIZE:-16}                # 4 -> 16: 8x the GPUs, 4x the prompts/step
export PPO_MINI=${PPO_MINI:-$BATCH_SIZE}           # == batch_size: one optimizer update per step,
                                                   # same semantics as the tuned 1-GPU run
export MAX_CONCURRENT=${MAX_CONCURRENT:-96}        # = BATCH_SIZE*N trajectories in flight
                                                   # (split across rollout.agent.num_workers, default 8)
export TOOL_WORKERS=${TOOL_WORKERS:-8}             # crop/resize is CPU-bound; 1 worker starves 8 GPUs

# ── SAHA-CF reward knobs (passed through to train_qwen3vl_v2.sh) ──
export ALPHA=${ALPHA:-0.6}
export N=${N:-6}
export TOTAL_STEPS=${TOTAL_STEPS:-1000}

# ── CPU offload: decided from the card's memory unless set explicitly ──
# Offload (params/optimizer to host RAM) is what makes the 8B fit a 40GB card,
# but it costs a lot of step time. On 80GB+ cards with FSDP sharding across 8
# GPUs it is unnecessary, and dropping it is the single biggest speedup.
GPU_MEM_MB=$(nvidia-smi --query-gpu=memory.total --format=csv,noheader,nounits 2>/dev/null | head -1)
if [[ -z "$DO_OFFLOAD" ]]; then
    if [[ -n "$GPU_MEM_MB" && "$GPU_MEM_MB" -ge 70000 ]]; then
        export DO_OFFLOAD=False
        export GPU_MEM=${GPU_MEM:-0.45}
        echo "GPU has ${GPU_MEM_MB}MB -> DO_OFFLOAD=False, gpu_memory_utilization=$GPU_MEM"
    else
        export DO_OFFLOAD=True
        export GPU_MEM=${GPU_MEM:-0.30}
        echo "GPU has ${GPU_MEM_MB:-unknown}MB -> DO_OFFLOAD=True (safe), gpu_memory_utilization=$GPU_MEM"
    fi
else
    export GPU_MEM=${GPU_MEM:-0.30}
    echo "DO_OFFLOAD=$DO_OFFLOAD (explicit), gpu_memory_utilization=$GPU_MEM"
fi

export SAHA_CF_GROUNDING_METRIC=${SAHA_CF_GROUNDING_METRIC:-minAR10}
export DATA_TAG=${DATA_TAG:-newsft-resampled-${MODEL_SIZE}}
export RESUME_MODE=${RESUME_MODE:-auto}

AUTO_RESUBMIT=${AUTO_RESUBMIT:-0}

# CONCURRENT=1: this job shares its node with another training run (e.g. two
# 4-GPU jobs on one 8-GPU node). Suppresses the node-wide Ray/tool-server kills
# that would otherwise take the sibling down at startup and at exit.
CONCURRENT=${CONCURRENT:-0}
if [[ "$CONCURRENT" == "1" ]]; then
    export SKIP_RAY_STOP=1
    echo "CONCURRENT=1 -> SKIP_RAY_STOP=1 (leaving sibling Ray/tool-server alone)"
fi

# train_qwen3vl_v2.sh defaults to `CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-1}`
# — a SINGLE GPU, index 1. On an 8-GPU job that would waste 7 of them, so make the
# full set explicit. If PBS already set it (indices or GPU-UUIDs) leave it alone;
# the training script remaps UUIDs to integers for vLLM.
if [[ -z "$CUDA_VISIBLE_DEVICES" ]]; then
    export CUDA_VISIBLE_DEVICES=$(seq -s, 0 $((NGPUS - 1)))
    echo "CUDA_VISIBLE_DEVICES was unset; pinned to $CUDA_VISIBLE_DEVICES"
fi
VISIBLE_COUNT=$(echo "$CUDA_VISIBLE_DEVICES" | tr ',' '\n' | grep -c .)
if [[ "$VISIBLE_COUNT" -ne "$NGPUS" ]]; then
    echo "WARNING: NGPUS=$NGPUS but $VISIBLE_COUNT GPU(s) visible ($CUDA_VISIBLE_DEVICES)." >&2
    echo "         Ray will request $NGPUS and hang or fail. Aligning NGPUS=$VISIBLE_COUNT." >&2
    export NGPUS=$VISIBLE_COUNT
fi

# ── Offline / cache settings (compute nodes have no outbound network) ──
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export HF_HOME=${HF_HOME:-$REPO_ROOT/../.cache/huggingface}
# wandb cannot reach the internet from a compute node: log offline, sync later
# from the login node with `wandb sync $WANDB_DIR/wandb/offline-run-*`.
export WANDB_MODE=${WANDB_MODE:-offline}
export WANDB_PROJECT=SAHA-CF
export LD_LIBRARY_PATH=$CONDA_PREFIX/lib:$LD_LIBRARY_PATH
# Packages installed outside the conda env (pip --target), e.g. flash_attn when
# the home-filesystem quota refuses the in-env install. Ray propagates the
# driver env to its actors, so the vLLM rollout workers inherit this too.
# Skipped silently when the dir does not exist.
EXTRA_PYTHONPATH=${EXTRA_PYTHONPATH:-/data/projects/11104496/pylibs}
if [[ -d "$EXTRA_PYTHONPATH" ]]; then
    export PYTHONPATH="$EXTRA_PYTHONPATH:$PYTHONPATH"
    echo "PYTHONPATH += $EXTRA_PYTHONPATH"
fi
# Run THIS copy of the code, whatever `pip install -e` happens to point at.
# PYTHONPATH precedes site-packages, so a stale editable install elsewhere (e.g.
# a home-quota failure left it pointing at another checkout) cannot shadow the
# checkout this job was submitted from.
export PYTHONPATH="$REPO_ROOT:$REPO_ROOT/verl:$PYTHONPATH"
echo "PYTHONPATH += $REPO_ROOT and $REPO_ROOT/verl"
# Ray + tmp on node-local scratch, not the shared filesystem (30s wandb timeout,
# and Ray's object store is far too slow on NFS).
export TMPDIR=${TMPDIR:-/tmp/${USER}_${PBS_JOBID%%.*}}
mkdir -p "$TMPDIR"
export RAY_TMPDIR=$TMPDIR

# ── Diagnostics ──
echo "=== Job Info ==="
echo "Job ID:   $PBS_JOBID"
echo "Node:     $(hostname)"
echo "Date:     $(date)"
echo "PWD:      $(pwd)"
echo "Model:    $MODEL_PATH"
echo "Train:    $TRAIN_PARQUET"
echo "Scale:    ngpus=$NGPUS tp=$TP offload=$DO_OFFLOAD gpu_mem=$GPU_MEM tool_workers=$TOOL_WORKERS"
echo "Knobs:    alpha=$ALPHA n=$N batch=$BATCH_SIZE mini=$PPO_MINI concurrent=$MAX_CONCURRENT metric=$SAHA_CF_GROUNDING_METRIC steps=$TOTAL_STEPS"
echo ""
nvidia-smi
python -c "import torch; print(f'PyTorch {torch.__version__}, CUDA {torch.cuda.is_available()}, GPUs {torch.cuda.device_count()}')"
python -c "import verl, verl_tool, os; print('verl     ->', os.path.dirname(verl.__file__)); print('verl_tool ->', os.path.dirname(verl_tool.__file__))"
echo "CUDA_VISIBLE_DEVICES=$CUDA_VISIBLE_DEVICES"
echo ""

# ─────────────────────────────────────────────────────────────────────────────
# Pre-flight — fail in seconds rather than after the model has loaded.
# ─────────────────────────────────────────────────────────────────────────────
echo "=== Pre-flight ==="
fail=0
for p in "$MODEL_PATH" "$TRAIN_PARQUET" "$VAL_PARQUET"; do
    if [[ ! -e "$p" ]]; then echo "MISSING: $p" >&2; fail=1; else echo "ok: $p"; fi
done

# The sitecustomize shim (transformers5 <-> vllm0.11 tokenizer + Triton ptxas)
# must be installed into site-packages or the vLLM rollout actors die on start.
python - <<'PY' || fail=1
import site, os, sys
p = os.path.join(site.getsitepackages()[0], "sitecustomize.py")
if not os.path.exists(p):
    print(f"MISSING: {p}\n  fix: cp patches/sitecustomize_transformers5_vllm.py {p}", file=sys.stderr)
    sys.exit(1)
print(f"ok: {p}")
PY

python -c "import flash_attn" 2>/dev/null && echo "ok: flash_attn importable" || {
    echo "MISSING: flash_attn (verl needs flash_attn.bert_padding for use_remove_padding)" >&2
    echo "  fix: pip install --no-deps --target \$EXTRA_PYTHONPATH flash-attn==2.8.3" >&2
    fail=1
}

# The parquet stores ABSOLUTE image paths baked in at data-prep time
# (/workspace/data/... on the dev box). If they do not resolve here, run:
#   python examples/data_preprocess/hoi/remap_image_paths.py \
#       --hico_cluster_dir $DATA_ROOT/hico_20160224_det \
#       --swig_cluster_dir $DATA_ROOT/swig_hoi --parquet_dir data
# The reward also needs extra_info.proposal_anchor; without it s_ref silently
# falls back to 0.0 and R_tool is meaningless.
TRAIN_PARQUET="$TRAIN_PARQUET" python - <<'PY' || fail=1
import os, sys, pyarrow.parquet as pq
f = pq.ParquetFile(os.environ["TRAIN_PARQUET"])
rows = f.read_row_group(0).slice(0, 200).to_pylist()
missing = [r["images"][0]["image"] for r in rows
           if r.get("images") and not os.path.exists(r["images"][0]["image"])]
if missing:
    print(f"IMAGE PATHS DO NOT RESOLVE ({len(missing)}/{len(rows)} sampled), e.g.:\n  "
          + "\n  ".join(missing[:3]) + "\n  fix: remap_image_paths.py (see comment above)",
          file=sys.stderr)
    sys.exit(1)
print(f"ok: images resolve ({len(rows)} sampled)")
anchored = sum(1 for r in rows if (r.get("extra_info") or {}).get("proposal_anchor"))
if anchored == 0:
    print("NO extra_info.proposal_anchor in the parquet -> s_ref would be 0.0 for every "
          "grounding sample.\n  fix: examples/data_preprocess/hoi/migrate_add_proposal_anchor.py",
          file=sys.stderr)
    sys.exit(1)
print(f"ok: proposal_anchor present ({anchored}/{len(rows)} sampled)")
PY

[[ $fail -ne 0 ]] && { echo "=== Pre-flight FAILED — not launching ===" >&2; exit 1; }
echo "=== Pre-flight OK ==="
echo ""

# ── Clean up Ray / tool-server on any exit path (incl. walltime SIGTERM) ──
cleanup() {
    echo "=== Cleanup at $(date) ==="
    if [[ "$CONCURRENT" == "1" ]]; then
        # Sharing the node with a sibling run: a node-wide pkill/ray stop would kill
        # it too. train_qwen3vl_v2.sh already kills its OWN tool server by pid.
        echo "CONCURRENT=1 -> skipping node-wide pkill/ray stop"
    else
        pkill -f "verl_tool.servers.serve" 2>/dev/null
        ray stop --force 2>/dev/null
    fi
    rm -rf "$TMPDIR" 2>/dev/null
}
trap cleanup EXIT TERM INT

# ── Run training ──
echo "=== Starting SAHA-CF GRPO ==="
bash examples/train/hoi/train_qwen3vl_v2.sh "$MODEL_PATH"
rc=$?
echo "=== Training exited rc=$rc at $(date) ==="

# ── Optional: chain the next job so the run survives the walltime cap ──
# resume_mode=auto picks up the last checkpoint under checkpoints/SAHA-CF/<run_name>.
if [[ "$AUTO_RESUBMIT" == "1" && $rc -ne 0 ]]; then
    echo "Resubmitting to continue from the last checkpoint..."
    qsub -v "AUTO_RESUBMIT=1,ALPHA=$ALPHA,MODEL_SIZE=$MODEL_SIZE,TOTAL_STEPS=$TOTAL_STEPS,DATA_TAG=$DATA_TAG,NGPUS=$NGPUS,BATCH_SIZE=$BATCH_SIZE,PPO_MINI=$PPO_MINI,DO_OFFLOAD=$DO_OFFLOAD,GPU_MEM=$GPU_MEM" \
         "$REPO_ROOT/examples/train/hoi/train_hoi_grpo_v2.pbs"
fi

exit $rc
